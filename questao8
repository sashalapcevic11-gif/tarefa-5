
import numpy as np
import matplotlib.pyplot as plt

# Dados observados
x=np.array([0,1.8,5,7,8.2,9.2,12])

y=np.array([26,16.415,5.375,3.5,2.015,2.54,8])

plt.plot(x,y,'ok')
plt.show()

# Interpolacao de Newton
n=len(x)

dif=np.zeros((n,n))
dif[:,0]=y

# Calculo das diferencas divididas
for j in range(1,n):
    for i in range(n-j):
        dif[i,j]=(dif[i+1,j-1]-dif[i,j-1])/(x[i+j]-x[i])

print('Tabela de diferencas divididas:')
print(dif)

# Coeficientes do polinomio
a=dif[0,:]

print('Coeficientes:')
print(a)

# Funcao do polinomio de Newton
def newton(xi):
    resultado=a[0]
    produto=1

    for i in range(1,n):
        produto=produto*(xi-x[i-1])
        resultado=resultado+a[i]*produto

    return resultado

# Calculo de f(3.5)
valor=3.5
resultado=newton(valor)

print('f(3.5) =',resultado)

# Verificacao nos pontos observados
for i in range(n):
    print('Erro no ponto',x[i],':',newton(x[i])-y[i])

# Grafico
xx=np.linspace(min(x),max(x),200)

plt.plot(x,y,'ok',label='dados observados')
plt.plot(xx,newton(xx),'-b',label='polinomio de Newton')
plt.plot(valor,resultado,'or',label='f(3.5)')
plt.xlabel('x')
plt.ylabel('y')
plt.grid()
plt.legend()
plt.show()
