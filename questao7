
import numpy as np
import matplotlib.pyplot as plt
import statistics as st

# Eliminação de Gauss
def eliminacaodegaussingenua(A,b):
    Aum=np.hstack((A,b))
    print(Aum)

    n=len(b)

    # Eliminação progressiva
    for i in range(n-1):
        for j in range(i+1,n):
            fator=Aum[j,i]/Aum[i,i]
            Aum[j,i:n+1]=Aum[j,i:n+1]-fator*Aum[i,i:n+1]

    print(Aum)

    # Substituição regressiva
    x=np.zeros(n)
    x[n-1]=Aum[n-1,n]/Aum[n-1,n-1]

    for i in range(n-2,-1,-1):
        soma=0
        for j in range(i+1,n):
            soma+=Aum[i,j]*x[j]
        x[i]=(Aum[i,n]-soma)/Aum[i,i]

    return x


# Dados observados
x=np.array([400,72,47,3,0.3,0.16])

y=np.array([270,80,50,4.8,1.45,0.97])

plt.plot(x,y,'ok')
plt.show()

# Transformacao com logaritmo natural
lnX=np.log(x)
lnY=np.log(y)

# Calculos previos
n=len(x)
sumXi=sum(lnX)
sumYi=sum(lnY)
sumXi2=sum(lnX*lnX)
sumXiYi=sum(lnX*lnY)

A=np.array([[n,sumXi],[sumXi,sumXi2]])
b=np.array([[sumYi],[sumXiYi]])

ai=eliminacaodegaussingenua(A,b)

# Calculo dos coeficientes
a=np.exp(ai[0])
b=ai[1]

print('a =',a)
print('b =',b)

# Calculo do coeficiente de determinacao R²
Sr=sum((lnY-(ai[0]+ai[1]*lnX))**2)
yMedio=st.mean(lnY)
St=sum((lnY-yMedio)**2)
R2=(St-Sr)/St
print('R² =',R2)

# Previsao do metabolismo do tigre
massa=200
metabolismo=a*massa**b

print('Metabolismo do tigre =',metabolismo,'W')

# Grafico
xx=np.linspace(min(x),max(x),100)

plt.plot(x,y,'ok',label="dados observados")
plt.plot(xx,a*xx**b,'-b',label="$y=ax^b$")
plt.plot(massa,metabolismo,'or',label="tigre de 200 kg")
plt.xlabel('Massa (kg)')
plt.ylabel('Metabolismo (W)')
plt.grid()
plt.legend()
plt.show()
